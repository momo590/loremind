# Loremind configuration — copy to .env and fill in

# LLM (required)
ANTHROPIC_API_KEY=sk-ant-...

# Campaign name (default: "default")
LOREMIND_CAMPAIGN=my-campaign

# WhatsApp provider: twilio (dev) or meta (prod)
WHATSAPP_PROVIDER=twilio

# Twilio (for dev/sandbox)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=+1415...

# Meta Cloud API (for production)
META_WHATSAPP_TOKEN=EAA...
META_PHONE_NUMBER_ID=...
META_VERIFY_TOKEN=loremind-webhook-secret
